{
  "genre": "racing",
  "note": "A worked example, executed on every build. Read genres/racing.md for why each decision was taken.",
  "calls": [
    {"tool": "types.upsert", "args": {
      "key": "driver", "label": "Driver", "label_plural": "Drivers",
      "field_schema": [
        {"key": "nationality", "type": "text", "label": "Nationality"},
        {"key": "pace", "type": "number", "label": "Pace", "min": 1, "max": 100},
        {"key": "consistency", "type": "number", "label": "Consistency", "min": 1, "max": 100},
        {"key": "team_name", "type": "text", "label": "Team, as written on the entry list"}
      ]}},
    {"tool": "types.upsert", "args": {
      "key": "car", "label": "Car", "label_plural": "Cars",
      "field_schema": [
        {"key": "category", "type": "enum", "label": "Category",
         "options": ["touring", "gt3", "lmp2", "formula"], "default": "gt3"},
        {"key": "power_bhp", "type": "number", "label": "Power (bhp)", "min": 60, "max": 1200},
        {"key": "weight_kg", "type": "number", "label": "Weight (kg)", "min": 400, "max": 2000},
        {"key": "drivetrain", "type": "enum", "label": "Drivetrain",
         "options": ["fwd", "rwd", "awd"], "default": "rwd"}
      ]}},
    {"tool": "types.upsert", "args": {
      "key": "upgrade", "label": "Upgrade", "label_plural": "Upgrades",
      "field_schema": [
        {"key": "slot", "type": "enum", "label": "Slot",
         "options": ["engine", "aero", "tyres", "gearbox", "brakes"], "default": "engine"},
        {"key": "cost", "type": "number", "label": "Cost in credits", "min": 0, "max": 500000},
        {"key": "stage", "type": "number", "label": "Stage", "min": 1, "max": 3}
      ]}},
    {"tool": "types.upsert", "args": {
      "key": "circuit", "label": "Circuit", "label_plural": "Circuits",
      "field_schema": [
        {"key": "country", "type": "text", "label": "Country"},
        {"key": "length_km", "type": "number", "label": "Lap length (km)", "min": 1, "max": 30},
        {"key": "turns", "type": "number", "label": "Turns", "min": 2, "max": 40},
        {"key": "surface", "type": "enum", "label": "Surface",
         "options": ["asphalt", "gravel", "mixed"], "default": "asphalt"}
      ]}},
    {"tool": "types.upsert", "args": {
      "key": "race", "label": "Race", "label_plural": "Races",
      "field_schema": [
        {"key": "laps", "type": "number", "label": "Laps", "min": 1, "max": 200},
        {"key": "weather", "type": "enum", "label": "Weather",
         "options": ["dry", "wet", "mixed"], "default": "dry"},
        {"key": "prize", "type": "number", "label": "Winner's prize", "min": 0, "max": 1000000},
        {"key": "night", "type": "bool", "label": "Run at night"}
      ]}},
    {"tool": "types.upsert", "args": {
      "key": "championship", "label": "Championship", "label_plural": "Championships",
      "field_schema": [
        {"key": "tier", "type": "enum", "label": "Tier",
         "options": ["club", "national", "continental", "world"], "default": "club"},
        {"key": "season_length", "type": "number", "label": "Rounds", "min": 2, "max": 24}
      ]}},
    {"tool": "types.upsert", "args": {
      "key": "licence", "label": "Licence", "label_plural": "Licences",
      "field_schema": [
        {"key": "grade", "type": "enum", "label": "Grade",
         "options": ["d", "c", "b", "a", "super"], "default": "d"},
        {"key": "tests", "type": "number", "label": "Tests to pass", "min": 1, "max": 12}
      ]}},

    {"tool": "relation_types.upsert", "args": {
      "key": "contains", "label": "Contains",
