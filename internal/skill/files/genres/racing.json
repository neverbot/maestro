    {"tool": "relation_types.upsert", "args": {
      "key": "takes_place_in", "label": "Takes place in",
      "source_type_keys": ["race"], "target_type_keys": ["circuit"],
      "semantic_role": "spatial", "analysis_traits": ["containment"]}},
    {"tool": "relation_types.upsert", "args": {
      "key": "requires", "label": "Requires",
      "source_type_keys": ["race", "championship", "driver", "upgrade"],
      "target_type_keys": ["licence", "upgrade"],
      "semantic_role": "prerequisite", "analysis_traits": ["prerequisite_of"]}},
    {"tool": "relation_types.upsert", "args": {
